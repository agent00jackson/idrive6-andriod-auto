# Extend the SDK's link-only stubs with exports verified on the target.
file(READ "${QNX_SDK}/share/qnx-sdk/qnx650.json" sdk_abi)
file(READ "${CMAKE_CURRENT_LIST_DIR}/qnx-extra-imports.json" additions)
set(merged "{\"format\":1,\"libraries\":[]}")
string(JSON count LENGTH "${sdk_abi}" libraries)
math(EXPR last "${count}-1")
set(merged_index 0)
foreach(index RANGE 0 ${last})
  string(JSON library GET "${sdk_abi}" libraries ${index})
  string(JSON soname GET "${library}" soname)
  string(JSON extras ERROR_VARIABLE missing GET "${additions}" "${soname}")
  if(missing)
    continue()
  endif()
  string(JSON length LENGTH "${extras}")
  math(EXPR end "${length}-1")
  foreach(i RANGE 0 ${end})
    string(JSON add GET "${extras}" ${i})
    string(JSON name GET "${add}" name)
    string(JSON symbols GET "${library}" symbols)
    if(symbols MATCHES "\"name\"[ \t\r\n]*:[ \t\r\n]*\"${name}\"")
      continue()
    endif()
    string(JSON size LENGTH "${symbols}")
    string(JSON library SET "${library}" symbols ${size} "${add}")
  endforeach()
  string(JSON merged SET "${merged}" libraries ${merged_index} "${library}")
  math(EXPR merged_index "${merged_index}+1")
endforeach()
set(abi_manifest "${CMAKE_BINARY_DIR}/merged-qnx-abi.json")
set(abi_dir "${CMAKE_BINARY_DIR}/qnx-link-only")
file(WRITE "${abi_manifest}" "${merged}\n")
qnx_import_manifest("${abi_manifest}" "${abi_dir}" AARuntime aa_runtime_interfaces)
foreach(lang C CXX)
  foreach(soname libc.so.3 libstdc++.so.6)
    string(REPLACE "${QNX_SDK}/usr/lib/${soname}" "${abi_dir}/${soname}"
      CMAKE_${lang}_STANDARD_LIBRARIES "${CMAKE_${lang}_STANDARD_LIBRARIES}")
  endforeach()
endforeach()
